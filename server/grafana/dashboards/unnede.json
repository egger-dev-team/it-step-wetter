    "list": [
      {
        "name": "station",
        "label": "Station",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "weatherstation-postgres" },
        "query": "SELECT DISTINCT station_id FROM weather_records ORDER BY station_id",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "selected": false, "text": "All", "value": "$__all" },
        "sort": 1
      },
      {
        "name": "weather_bg",
        "label": "Weather Background",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "weatherstation-postgres" },
        "query": "SELECT CASE WHEN niederschlag > 0.2 AND temperatur < 1 THEN 'https://images.unsplash.com/photo-1491002052546-bf38f186af56?auto=format&fit=crop&w=1920&h=400&q=70' WHEN niederschlag > 0.2 THEN 'https://images.unsplash.com/photo-1519692933481-e162a57d6721?auto=format&fit=crop&w=1920&h=400&q=70' WHEN windgeschwindigkeit > 30 THEN 'https://images.unsplash.com/photo-1527482797697-8795b05a13fe?auto=format&fit=crop&w=1920&h=400&q=70' WHEN helligkeit < 100 THEN 'https://images.unsplash.com/photo-1507400492013-162706c8c05e?auto=format&fit=crop&w=1920&h=400&q=70' WHEN helligkeit > 20000 AND temperatur > 18 AND windgeschwindigkeit < 25 AND niederschlag <= 0.1 THEN 'https://images.unsplash.com/photo-1517677208171-0bc6725a3e60?auto=format&fit=crop&w=1920&h=400&q=70' ELSE 'https://images.unsplash.com/photo-1499346030926-9a72daac6c63?auto=format&fit=crop&w=1920&h=400&q=70' END AS bg_url FROM weather_records WHERE station_id IN ($station) ORDER BY received_at DESC LIMIT 1;",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0
      },
      {
        "name": "weather_label",
        "label": "Weather Label",
        "type": "query",
        "datasource": { "type": "postgres", "uid": "weatherstation-postgres" },
        "query": "SELECT CASE WHEN niederschlag > 0.2 AND temperatur < 1 THEN 'Snowy ❄' WHEN niederschlag > 0.2 THEN 'Rainy ☔' WHEN windgeschwindigkeit > 30 THEN 'Windy 💨' WHEN helligkeit < 100 THEN 'Night 🌙' WHEN helligkeit > 20000 AND temperatur > 18 AND windgeschwindigkeit < 25 AND niederschlag <= 0.1 THEN 'Sunny ☀' ELSE 'Cloudy ☁' END AS label FROM weather_records WHERE station_id IN ($station) ORDER BY received_at DESC LIMIT 1;",
        "refresh": 2,
        "hide": 2,
        "includeAll": false,
        "multi": false,
        "sort": 0
      }
    ]
  },
